4. 

I am trying to create a section template on shopify
It will also use blocks and be able to add blocks
... the one we were doing before doesn't add blocks

it will have:

An Image picker
An Image position dropdown or switch: Left / Right
The image will actually move left or right when you change the setting.


{% comment %}
  Image Position Test

  Section settings:
  - Image position: Left / Right

  Blocks:
  - Image
  - Text

  Merchants can:
  - Add blocks
  - Delete blocks
  - Reorder blocks
  - Edit each block
{% endcomment %}

{% schema %}
{
  "name": "Image position test",

  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    }
  ],

  "blocks": [
    {
      "type": "image",
      "name": "Image",

      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },

    {
      "type": "text",
      "name": "Text",

      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },

        {
          "type": "textarea",
          "id": "body",
          "label": "Body text"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Image position test",

      "blocks": [
        {
          "type": "image"
        },

        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}





<div class="image-section image-section--{{ section.settings.image_position }}">
  <div class="image-section__content">
    {% for block in section.blocks %}


      {% if block.type == 'image' %}
        <div class="image-block" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 800 | image_tag }}
          {% else %}
            <p>Please select an image</p>
          {% endif %}
        </div>


      {% elsif block.type == 'text' %}
        <div class="text-block" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <h2>{{ block.settings.heading }}</h2>
          {% endif %}

          {% if block.settings.body != blank %}
            <p>{{ block.settings.body }}</p>
          {% endif %}
        </div>


      {% endif %}
    {% endfor %}
  </div>

</div>




<style>

  .image-section {
    width: 100%;
  }


  .image-section__content {
    display: flex;
    align-items: center;
    gap: 40px;
  }


  .image-section--left
  .image-section__content {
    flex-direction: row;
  }


  .image-section--right
  .image-section__content {
    flex-direction: row-reverse;
  }


  .image-block {
    width: 50%;
  }


  .image-block img {
    display: block;
    width: 100%;
    height: auto;
  }


  .text-block {
    width: 50%;
  }


</style>









