Practice 2 update if we make the video and image a toggle switch
{% comment %}
  Hero section
  - Media: image or video
  - Media 2: image or video
  - Section link
{% endcomment %}


{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_1_type",
      "label": "Type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image",
      "visible_if": "{{ section.settings.media_1_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video_1",
      "label": "Video",
      "visible_if": "{{ section.settings.media_1_type == 'video' }}"
    },

    {
      "type": "header",
      "content": "Media 2"
    },
    {
      "type": "select",
      "id": "media_2_type",
      "label": "Type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image",
      "visible_if": "{{ section.settings.media_2_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video_2",
      "label": "Video",
      "visible_if": "{{ section.settings.media_2_type == 'video' }}"
    },

    {
      "type": "header",
      "content": "Section link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}




{% assign link_url = section.settings.link %}

{% if link_url != blank %}
  <a href="{{ link_url }}" class="Hero-link" {% if section.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>
{% endif %}



<div class="Hero">
  <div class="Hero-block">
    {% if section.settings.media_1_type == 'image' and section.settings.image_1 != blank %}
      {{ section.settings.image_1 | image_url: width: 1000 | image_tag }}
    {% elsif section.settings.media_1_type == 'video' and section.settings.video_1 != blank %}
      {{ section.settings.video_1 | video_tag: controls: true, autoplay: true, loop: true, muted: true }}
    {% else %}
      <p>Please add your image or video</p>
    {% endif %}
  </div>

  <div class="Hero-block">
    {% if section.settings.media_2_type == 'image' and section.settings.image_2 != blank %}
      {{ section.settings.image_2 | image_url: width: 1000 | image_tag }}
    {% elsif section.settings.media_2_type == 'video' and section.settings.video_2 != blank %}
      {{ section.settings.video_2 | video_tag: controls: true, autoplay: true, loop: true, muted: true }}
    {% else %}
      <p>Please add your image or video</p>
    {% endif %}
  </div>
</div>

{% if link_url != blank %}
  </a>
{% endif %}



<style>
  .Hero {
    display: flex;
    height: 512px;
    width: 100%;
  }

  .Hero-block {
    display: flex;
    height: 100%;
    width: 50%;
  }

  .Hero-block img,
  .Hero-block video {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  .Hero-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
</style>








