 .featured-collection-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  /* section.id is unique per section instance. 
  If you drag this section onto the page twice, each copy gets its own section.id 
  (something like template--123__featured_collection), 
  so .featured-collection-{{ section.id }} produces a different CSS class for each one. 
  That's what lets two copies of the same section have different padding values without fighting each other.

  */
  
.featured-collection--full-width {
    padding-left: 0;
    padding-right: 0;
}

.featured-collection__heading {
    text-align: center;
    margin-bottom: 30px;
    font-size: 40px;
  }

.featured-collection__description {
    font-size: 16px;
    margin-top: 10px;
}

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-mobile), 1fr);
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .featured-collection__grid--swipe {
     grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--columns-mobile) - 1) * 20px) / var(--columns-mobile));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .featured-collection__grid--swipe .featured-collection__item {
    scroll-snap-align: start;

}

  @media screen and (min-width: 768px) {

    .featured-collection__grid {
        grid-template-columns: repeat(var(--columns-desktop), 1fr);
    }


     .featured-collection__grid--slider-desktop {
        grid-template-columns: none;   /* <-- add this line */
        grid-auto-flow: column;
        grid-auto-columns: calc((100% - (var(--columns-desktop) - 1) * 20px) / var(--columns-desktop));
        /* This math formula automatically calculates the exact width of a single column when using CSS Grid.
        It ensures that no matter how many columns you want (var(--columns-desktop)), 
        they will all fit perfectly onto one single row, leaving exactly 20px of space (gaps) between them, 
        without stretching past 100% of the screen width. 


        If you have 4 columns, you only have 3 gaps between them.
        The math does: (4 - 1) * 20px → 3 * 20px = 60px.
        Result: The total space needed just for the gaps is 60px.

        Subtract the Gaps from the Total Width
        100% - (60px)


        The browser takes the full width available (100%) and 
        subtracts the gap space (60px).
        Result: You are left with the exact remaining space available only for the actual content blocks.
        

        (Remaining Space) / var(--columns-desktop)

        Finally, the browser takes that remaining space and 
        divides it cleanly by the number of columns (4).
        Result: Every column gets the exact same pixel width down to the decimal point.


        Why Use grid-auto-columns with this Math?
        Normally, CSS Grid wraps items to the next line. 
        However, in Shopify sections (like product carousels or sliders), 
        developers use grid-auto-columns to force items to stay on one single horizontal line 
        so users can swipe through them.
        By using this specific formula, the browser ensures that exactly 4 items fit perfectly on the screen at once, 
        and the 5th item sits just off-screen, waiting to be scrolled into view!

        */
        overflow-x: auto;
        scroll-snap-type: x mandatory;

        /* scroll-snap-type: x mandatory        tells the browser "when the user stops scrolling, 
        snap to a stopping point," and 
        scroll-snap-align: start         on each item tells it "this element is a valid stopping point.
        " No JavaScript needed for basic snap-scrolling — that's the whole trick. */

        padding-bottom: 10px;
    }


     .featured-collection__grid--slider-desktop .featured-collection__item {
        scroll-snap-align: start;
    }



    
  }

